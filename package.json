{
  "name": "haxball-client",
  "productName": "HaxBall",
  "version": "2.9.0",
  "description": "HaxBall Client for Android, Windows, macOS, and Linux with Smart-Hold Joystick and Soft Virtual Keyboard",
  "main": "electron/main.js",
  "author": "Can Kızılyar <cnkzlyrr@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/cnkzlyr/haxball-mobile",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux deb rpm AppImage",
    "dist:all": "electron-builder -mwl",
    "dist:linux:main": "electron-builder --linux deb AppImage"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.agy.haxball",
    "productName": "HaxBall",
    "copyright": "Copyright © 2026 Can Kızılyar",
    "files": [
      "assets/**/*",
      "electron/**/*",
      "package.json",
      "res/drawable/ic_launcher.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "res/drawable/ic_launcher.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HaxBall",
      "artifactName": "HaxBall-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "res/drawable/ic_launcher.png",
      "artifactName": "HaxBall-${version}-${arch}-mac.${ext}"
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "category": "Game",
      "icon": "res/drawable/ic_launcher.png",
      "synopsis": "HaxBall Client for Linux",
      "description": "Fast, responsive HaxBall client with low latency WebRTC and keyboard tapping support"
    },
    "deb": {
      "packageCategory": "games",
      "priority": "optional",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "xdg-utils"
      ],
      "artifactName": "haxball_${version}_${arch}.${ext}"
    },
    "rpm": {
      "fpm": [
        "--rpm-os",
        "linux"
      ],
      "artifactName": "haxball-${version}.${arch}.${ext}"
    },
    "icon": "res/drawable/ic_launcher.png",
    "publish": null,
    "portable": {
      "artifactName": "HaxBall-Portable-${version}.${ext}"
    },
    "dmg": {
      "artifactName": "HaxBall-${version}-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "HaxBall-${version}.${ext}"
    }
  }
}
